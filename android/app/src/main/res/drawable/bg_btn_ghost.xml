<?xml version="1.0" encoding="utf-8"?>
<!-- Вторичные действия («Найти сервер», «Экономия батареи»): тёмная
     «ghost»-кнопка с тонкой рамкой и ripple, чтобы не спорить с главной. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2effffff">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kassa_panel" />
            <stroke android:width="1dp" android:color="@color/kassa_line" />
            <corners android:radius="@dimen/panel_radius" />
        </shape>
    </item>
</ripple>
