<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LAN-сервер печатается по http: это локальная сеть магазина, а не
         публичный сайт. Разрешаем cleartext точечно — см. network_security_config. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Телефон в кармане не должен резать фоновые соединения каждые пять минут:
         для кассы важнее услышать платёж, чем сберечь 1-2% батареи. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Фоновый слух платежей: экран погашен, а «пришли деньги» должно быть
         слышно. Тип specialUse — потому что это не загрузка контента и не
         мессенджер: короткое SSE-соединение к серверу кассы в той же сети. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kassa">
        <!-- Без screenOrientation: касса на подставке часто стоит боком, ландшафт
             должен работать так же, как портрет. configChanges (включая fontScale)
             намеренно перехватывает поворот/плотность/масштаб шрифта, чтобы
             WebView не пересоздавался и не терял корзину кассира посреди продажи;
             панель выбора сервера при этом пересобирается в onConfigurationChanged.
             adjustResize: при вводе адреса клавиатура сжимает окно, а не прячет
             кнопку «Открыть кассу» за собой. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android:foreground.service.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="cashier payment ring over LAN" />
        </service>
    </application>
</manifest>
