<?xml version="1.0" encoding="utf-8"?>
<!-- Цех живёт в своей подсети: туда ходим по http, и адрес сервера можно
     продиктовать вслух. Наружу приложение не ходит вообще. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
